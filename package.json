{
  "name": "@creepiest-space/project-template",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "bun run quality:test",
    "test:unit": "turbo test:unit && bun run --if-present capability:test:unit",
    "test:integration": "turbo test:integration && bun run --if-present capability:test:integration",
    "test:e2e": "turbo test:e2e && bun run --if-present capability:test:e2e",
    "typecheck": "turbo typecheck",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "lint:types": "oxlint --type-aware .",
    "lint:styles": "bun run --if-present capability:styles",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "deadcode": "bun run check:deadcode",
    "check:deadcode": "knip --config ./knip.config.mts",
    "check:case": "case-police",
    "check:spelling": "cspell .",
    "check:architecture": "depcruise apps packages --config dependency-cruiser.config.mjs",
    "quality:static": "bun run format:check && bun run lint && bun run lint:types && bun run lint:styles && bun run typecheck",
    "quality:hygiene": "bun run check:case && bun run check:spelling",
    "check:package": "bun run --if-present capability:package",
    "check:security": "bun run --if-present capability:security",
    "quality:codebase": "bun run check:deadcode && bun run check:architecture && bun run check:package && bun run check:security",
    "quality:test": "bun run test:unit && bun run test:integration",
    "quality:fast": "bun run quality:static && bun run check:deadcode && bun run test:unit",
    "quality": "bun run quality:static && bun run quality:hygiene && bun run quality:codebase && bun run quality:test && bun run build && bun run test:e2e",
    "check": "bun run quality:fast",
    "check:full": "bun run quality",
    "commit": "bunx --bun czg --config=./cz.config.mts",
    "pack:create-project": "bun run --cwd packages/create-project pack:npm",
    "pack:create-project:dry-run": "bun run --cwd packages/create-project pack:npm:dry-run",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^20.19.0",
    "case-police": "^2.2.1",
    "cspell": "^10.1.1",
    "czg": "^1.13.0",
    "dependency-cruiser": "^18.2.0",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.0",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.3.14"
}
