{
  "id": "stylelint",
  "devDependencies": {
    "postcss-less": "^6.0.0",
    "postcss-sass": "^0.5.0",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "scripts": {
    "capability:styles": "stylelint \"**/*.{css,scss,sass,less,pcss,postcss}\" --allow-empty-input",
    "lint:styles:fix": "stylelint \"**/*.{css,scss,sass,less,pcss,postcss}\" --allow-empty-input --fix"
  }
}
