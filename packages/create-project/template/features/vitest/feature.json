{
  "id": "vitest",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "capability:test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
