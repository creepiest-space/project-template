{
  "name": "{{projectName}}-library",
  "version": "0.0.0",
  "description": "Reusable TypeScript library",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --target=bun --outdir=dist && bunx tsc --project tsconfig.build.json",
    "check:package": "bun run build && publint && bun ./scripts/verify-package.ts",
    "test:unit": "vitest run --passWithNoTests",
    "typecheck": "bunx tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
