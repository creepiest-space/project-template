{
  "name": "@creepiest-space/create-project",
  "version": "0.1.0",
  "description": "Create a Creepiest Space Bun and TypeScript project",
  "keywords": [
    "bun",
    "create",
    "monorepo",
    "scaffold",
    "typescript"
  ],
  "license": "MIT",
  "bin": {
    "create-project": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun run clean && bun build ./src/cli.ts ./src/index.ts --target=bun --outdir=dist && bunx tsc --project tsconfig.build.json",
    "clean": "bun ./scripts/clean.ts",
    "pack:npm": "bun pm pack --destination ../../artifacts",
    "pack:npm:dry-run": "bun pm pack --dry-run",
    "prepack": "bun run build && bun run verify:package",
    "prepublishOnly": "bun run typecheck && bun run test",
    "publish:npm": "bun publish --access public",
    "publish:npm:dry-run": "bun publish --dry-run --access public",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "verify:package": "bun ./scripts/verify-package.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
